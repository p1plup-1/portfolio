 "findings": [
  {
   "level": "WARN",
   "id": "first-action",
   "width": 1440,
   "message": "No visible button in the first screen.",
   "fix": "Give the one primary action a real button in the first screen (a filled or solid-bordered control, 44px or taller), not only a link in the navigation.",
   "alsoAt": [
    768,
    390
   ]
  },
  {
   "level": "FAIL",
   "id": "few-pictures",
   "width": 1440,
   "message": "Only 3 picture(s) on the page (3 photographs, footage or raster images, 0 interface fragments). Drawings in SVG do not count.",
   "fix": "Find real pictures of the subject's world with scripts/assets.mjs (photographs, archival images, maps, engravings, footage), download them to assets/ and give them room: a hero picture, one per section that has a subject, a full-width band. At least four, usually six to twelve."
  },
  {
   "level": "WARN",
   "id": "no-footage",
   "width": 1440,
   "message": "No video anywhere on the page.",
   "fix": "Look for one honest clip with scripts/assets.mjs --video (the place, the material, the process) and use it as a muted loop with a poster frame. Defend its absence only if no clip fits the subject."
  },
  {
   "level": "WARN",
   "id": "all-centred",
   "width": 1440,
   "message": "88% of the text is centre-aligned.",
   "fix": "Centre one moment at most; anchor the rest to a shared left edge.",
   "alsoAt": [
    768
   ]
  },
  {
   "level": "FAIL",
   "id": "focal-point",
   "width": 1440,
   "message": "The first screen has no dominant element: the largest type is 28px (1.9vw) and no single picture holds a third of the viewport.",
   "fix": "Make one thing lead: the headline at display size, or one large picture. A grid of many small pictures is not one thing; in blind tests jurors marked a first screen without a headline down every time. On the strongest studied sites the largest type has a median of 8.4vw.",
   "alsoAt": [
    768
   ]
  },
  {
   "level": "WARN",
   "id": "font-not-dealt",
   "width": 1440,
   "message": "The sheet dealt Archivo and Archivo, but the page renders Hanken Grotesk.",
   "fix": "Load the dealt face (the link on the sheet) and put it first in font-family. A build that falls back to a default face lands on the default look."
  },
  {
   "level": "FAIL",
   "id": "blank-gap",
   "width": 1440,
   "message": "1 stretch(es) of the page hold nothing at all: 852px at 788px (the screen is 900px tall).",
   "fix": "Close the gap: a section gap is 120–240px on desktop and 72–112px on a phone. Look for a min-height: 100vh on a short section, an empty grid row, a hidden element still holding its space, or a reveal that never fired. A deliberate rest is a placed picture or colour field, not nothing.",
   "alsoAt": [
    768
   ]
  },
  {
   "level": "WARN",
   "id": "small-title",
   "width": 1440,
   "message": "The h1 is 18px (\"Hello!\").",
   "fix": "Set the title at display size, or make the large text of the first screen the h1.",
   "alsoAt": [
    768,
    390
   ]
  },
  {
   "level": "WARN",
   "id": "name-only-title",
   "width": 1440,
   "message": "The h1 is a bare name (\"Hello!\") and nothing else on the first screen says what this is.",
   "fix": "Keep the name if it leads, and give the line under it (18px or more) the plain words: what it is, for whom, where or when. In the study of 97 Sites of the Day, first screens that named nothing lost usability and content points.",
   "alsoAt": [
    768,
    390
   ]
  },
  {
   "level": "FAIL",
   "id": "still-page",
   "width": 1440,
   "message": "Only 0 element(s) moved while the page loaded and scrolled.",
   "fix": "Build the motion layer (SKILL.md step 9, references/motion.md): the signature move, an entrance for the parts of every section, feedback on every control, and one moving picture. Transform and opacity only, with a reduced-motion fallback."
  },
  {
   "level": "FAIL",
   "id": "reduced-hidden",
   "width": 1440,
   "message": "With reduced motion requested, 6 text block(s) on the first screen stay invisible: \"Modular Power Grid\", \"snap-together outlet and USB modules\", \"NAS for Logitech\", \"network storage\"",
   "fix": "Put every hidden starting state inside @media (prefers-reduced-motion: no-preference); the reduced page is the finished page (references/motion.md §8)."
  }
