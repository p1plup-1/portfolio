  {
   "level": "WARN",
   "id": "first-action",
   "width": 1440,
   "message": "No visible button in the first screen.",
   "fix": "Give the one primary action a real button in the first screen (a filled or solid-bordered control, 44px or taller), not only a link in the navigation.",
   "alsoAt": [
    768,
    390
   ]
  },
  {
   "level": "FAIL",
   "id": "few-pictures",
   "width": 1440,
   "message": "Only 0 picture(s) on the page (0 photographs, footage or raster images, 0 interface fragments). Drawings in SVG do not count.",
   "fix": "Find real pictures of the subject's world with scripts/assets.mjs (photographs, archival images, maps, engravings, footage), download them to assets/ and give them room: a hero picture, one per section that has a subject, a full-width band. At least four, usually six to twelve."
  },
  {
   "level": "WARN",
   "id": "no-footage",
   "width": 1440,
   "message": "No video anywhere on the page.",
   "fix": "Look for one honest clip with scripts/assets.mjs --video (the place, the material, the process) and use it as a muted loop with a poster frame. Defend its absence only if no clip fits the subject."
  },
  {
   "level": "WARN",
   "id": "name-only-title",
   "width": 1440,
   "message": "The h1 is a bare name (\"Edward Xu\") and nothing else on the first screen says what this is.",
   "fix": "Keep the name if it leads, and give the line under it (18px or more) the plain words: what it is, for whom, where or when. In the study of 97 Sites of the Day, first screens that named nothing lost usability and content points.",
   "alsoAt": [
    768,
    390
   ]
  },
  {
   "level": "WARN",
   "id": "hero-void",
   "width": 1440,
   "message": "56% of the first screen is one empty block (1200×600px at 240,300).",
   "fix": "Place the void on purpose or fill it: move the picture, the film or one fact into it, grow the headline to meet it, or shrink the screen to its content. A void reads as placed only when something closes it on the far side and it is the screen's one rest."
  },
  {
   "level": "FAIL",
   "id": "still-page",
   "width": 1440,
   "message": "Only 0 element(s) moved while the page loaded and scrolled.",
   "fix": "Build the motion layer (SKILL.md step 9, references/motion.md): the signature move, an entrance for the parts of every section, feedback on every control, and one moving picture. Transform and opacity only, with a reduced-motion fallback."
  },
  {
   "level": "FAIL",
   "id": "overflow",
   "width": 768,
   "message": "Page scrolls sideways by 8px at 768px.",
   "fix": "Constrain the element that is wider than the viewport (max-width: 100%, or overflow: clip on its section)."
  },
  {
   "level": "FAIL",
   "id": "reduced-hidden",
   "width": 1440,
   "message": "With reduced motion requested, 2 text block(s) on the first screen stay invisible: \"Project 01\", \"Project 02\"",
   "fix": "Put every hidden starting state inside @media (prefers-reduced-motion: no-preference); the reduced page is the finished page (references/motion.md §8)."
  }
